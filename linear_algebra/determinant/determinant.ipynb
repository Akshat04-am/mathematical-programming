   "source": [
    "import numpy as np\n",
    "\n",
    "x = np.array([[1],\n",
    "            [2]])\n",
    "y = np.array([[1],\n",
    "            [2]])\n",
    "\n",
    "A = np.column_stack((x, y))\n",
    "\n",
    "if np.linalg.det(A) == 0:\n",
    "    print(\"Dependent\")\n",
    "else:\n",
    "    print(\"Independent\")"
   ]
